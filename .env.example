# Copy this file to `.env.local` and fill in real values.
# These same variables must also be added in Vercel → Project → Settings →
# Environment Variables so the contact & quote forms work on the live site.

# Mail server (cPanel / webmail) — host: https://mail.apexnovalogistics.com/
SMTP_HOST=mail.apexnovalogistics.com

# 465 = implicit SSL/TLS (recommended). Use 587 for STARTTLS.
SMTP_PORT=465

# The authenticated mailbox that sends the enquiry emails.
SMTP_USER=info@apexnovalogistics.com
SMTP_PASS=your-mailbox-password

# Inbox that receives the enquiries (defaults to SMTP_USER if left blank).
CONTACT_EMAIL=info@apexnovalogistics.com
